#!/bin/sh

case "$1" in
    bound|renew)
        ifconfig "$interface" "$ip" netmask "$subnet" up
        route del default 2>/dev/null

        for r in $router; do
            route add default gw "$r" dev "$interface"
            break
        done

        echo -n > /etc/resolv.conf
        for d in $dns; do
            echo "nameserver $d" >> /etc/resolv.conf
        done
        ;;
esac
