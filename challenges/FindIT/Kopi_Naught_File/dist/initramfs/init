#!/bin/sh

export PATH=/bin:/sbin

mount -t proc proc /proc
mount -t sysfs sysfs /sys

mount -t devtmpfs devtmpfs /dev 2>/dev/null || {
    mount -t tmpfs tmpfs /dev
    mknod -m 600 /dev/console c 5 1
    mknod -m 666 /dev/null c 1 3
    mknod -m 666 /dev/zero c 1 5
    mknod -m 666 /dev/tty c 5 0
}

mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null

ip link set lo up
ip link set eth0 up
udhcpc -i eth0 -s /etc/udhcpc/default.script -q || echo "[!] DHCP failed"

chmod 0400 /dev/vda
ln -sf /dev/vda /root/flag

addgroup -g 1337 user
adduser -D -H -u 1337 -G user -h /home/user -s /bin/sh user

# --- CHANGE STARTS HERE ---
# Instead of using adduser, we manually write the entry with UID 0000
# echo "user:x:0000:1337:Linux User,,,:/home/user:/bin/sh" >> /etc/passwd
# --- CHANGE ENDS HERE ---

mkdir -p /home/user

clear
cat /banner

# cat /proc/kallsyms | grep page_copy
# cat /proc/kallsyms | grep ".stext"

cd /home/user || cd /tmp
exec setsid cttyhack /bin/su user
